{
  "name": "slopstack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "sh -c 'cd apps/server && go run github.com/air-verse/air@latest -c .air.toml'",
    "dev:web": "pnpm --filter @slopstack/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "generate:api": "go run ./apps/server/cmd/slopstack openapi export",
    "generate:client": "pnpm --filter @slopstack/web generate:client",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "concurrently": "^9.2.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.47.0"
  }
}
